+		let value = match result {
+			Ok(value) => value,
+			Err(error) => {
+				let _ = Self::write_progress("", true, false);
+				return Err(error);
+			}
+		};
 		Ok((value, started.elapsed().as_secs_f64(), true))
 	}
 }
