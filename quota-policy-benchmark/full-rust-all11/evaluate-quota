#!/bin/sh
set -eu

cd "$(dirname "$0")"

source_db=/home/nate/.cache/codex-quota-analysis.UfQxaA/all_usage.duckdb
cache_dir=/home/nate/.cache/quota-evaluator
corpus_query="WITH source AS (
    SELECT *, epoch_ms(usage_ts) AS usage_ms,
        coalesce(nullif(thread_id, ''), nullif(session_id, ''), source_file) AS cache_key,
        coalesce(response_id, '') AS response_key
    FROM responses_clean
    WHERE NOT missing_model AND NOT missing_timestamp
        AND NOT invalid_limit_metadata AND NOT invalid_token_invariant
        AND plan_type = 'pro' AND limit_id = 'codex' AND window_minutes = 10080
        AND model IN ('gpt-5.6-sol', 'gpt-5.6-luna', 'gpt-5.6-terra', 'gpt-6-astra')
), corpus AS (
    SELECT *,
        last_value(CASE WHEN input_tokens > 0 THEN usage_ms END IGNORE NULLS) OVER cache_window AS previous_turn_usage_ms,
        last_value(CASE WHEN input_tokens > 0 THEN input_tokens END IGNORE NULLS) OVER cache_window AS previous_turn_input_tokens,
        lead(usage_ms) OVER next_window AS next_turn_usage_ms,
        lead(cached_input_tokens) OVER next_window AS next_turn_cached_input_tokens,
        lag(used_percent) OVER quota_window AS previous_used_percent,
        lag(resets_at) OVER quota_window AS previous_resets_at
    FROM source
    WINDOW cache_window AS (
        PARTITION BY cache_key, model ORDER BY usage_ms, response_key, source_file
        ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
    ), next_window AS (
        PARTITION BY cache_key, model ORDER BY usage_ms, response_key, source_file
    ), quota_window AS (ORDER BY usage_ms, response_key, source_file)
)
SELECT model, usage_ms, input_tokens, cached_input_tokens, output_tokens,
    resets_at, used_percent, previous_turn_usage_ms, previous_turn_input_tokens,
    next_turn_usage_ms, next_turn_cached_input_tokens,
    previous_used_percent, previous_resets_at
FROM corpus"

[ -d "$cache_dir" ] || mkdir -p "$cache_dir"
source_stamp=$(stat -c '%i:%s:%y:%z' "$source_db")
cache_key=$(printf '%s\n%s\n' "$source_stamp" "$corpus_query" | sha256sum)
cache_file="$cache_dir/${cache_key%% *}.parquet"
cache_db="$cache_dir/${cache_key%% *}.duckdb"
if [ ! -f "$cache_db" ]; then
    (
        flock 9
        if [ ! -f "$cache_file" ]; then
            temporary=$(mktemp "$cache_dir/corpus.XXXXXX.parquet")
            trap 'rm -f -- "$temporary"' EXIT HUP INT TERM
            duckdb -readonly "$source_db" -c "COPY ($corpus_query) TO '$temporary' (FORMAT PARQUET);"
            [ "$source_stamp" = "$(stat -c '%i:%s:%y:%z' "$source_db")" ] || {
                printf 'quota source changed while preparing the cache\n' >&2
                exit 1
            }
            mv "$temporary" "$cache_file"
            trap - EXIT HUP INT TERM
        fi
        if [ ! -f "$cache_db" ]; then
            temporary_dir=$(mktemp -d "$cache_dir/corpus-db.XXXXXX")
            temporary_db="$temporary_dir/cache.duckdb"
            trap 'rm -f -- "$temporary_db"; rmdir -- "$temporary_dir"' EXIT HUP INT TERM
            duckdb "$temporary_db" -c "CREATE TABLE quota_corpus AS SELECT * FROM read_parquet('$cache_file');"
            [ "$source_stamp" = "$(stat -c '%i:%s:%y:%z' "$source_db")" ] || {
                printf 'quota source changed while preparing the cache\n' >&2
                exit 1
            }
            mv "$temporary_db" "$cache_db"
            rmdir -- "$temporary_dir"
            trap - EXIT HUP INT TERM
        fi
    ) 9> "$cache_dir/build.lock"
fi


evaluator_bin=${RECIPE_QUOTA_EVALUATOR_BIN:-/home/nate/codex/quota-rust/target/release/quota-rust}
evaluator_devices=${RECIPE_QUOTA_DEVICES:-amd0.cpu.archy:nv0.nv1.nv2.nv3.nv4.nv5.nv6.nv7.cpu}
evaluator_setup=${RECIPE_QUOTA_EVALUATOR_SETUP-/home/nate/codex/evaluator-speed/quota-setup.sql}

if [ -n "$evaluator_setup" ]; then
    [ -f "$evaluator_setup" ] || {
        printf '%s\n' "quota evaluator setup SQL is missing: $evaluator_setup" >&2
        exit 1
    }
    setup_hash=$(sha256sum "$evaluator_setup")
    constants_db="${cache_db%.duckdb}.constants-${setup_hash%% *}.duckdb"
    if [ ! -f "$constants_db" ]; then
        (
            flock 9
            if [ ! -f "$constants_db" ]; then
                constants_dir=$(mktemp -d "$cache_dir/constants.XXXXXX")
                constants_tmp="$constants_dir/cache.duckdb"
                trap 'rm -f -- "$constants_tmp"; rmdir -- "$constants_dir"' EXIT HUP INT TERM
                setup_sql=$(sed 's/^CREATE TEMP TABLE/CREATE TABLE/; s/^FROM quota_corpus;/FROM source.quota_corpus;/' "$evaluator_setup")
                duckdb "$constants_tmp" -c "ATTACH '$cache_db' AS source (READ_ONLY);
$setup_sql
CREATE VIEW quota_corpus AS SELECT * EXCLUDE (observed_increment) FROM quota_observed;" > /dev/null
                mv "$constants_tmp" "$constants_db"
                rmdir -- "$constants_dir"
                trap - EXIT HUP INT TERM
            fi
        ) 9> "$cache_dir/build.lock"
    fi
    cache_db="$constants_db"
fi

metrics_log=${RECIPE_QUOTA_METRICS_LOG:-}
if [ -z "$metrics_log" ] && [ -n "${RECIPE_QUOTA_METRICS_DIR:-}" ] && [ -n "${RECIPE_QUOTA_RUN_ID:-}" ]; then
    metrics_log="$RECIPE_QUOTA_METRICS_DIR/$RECIPE_QUOTA_RUN_ID.tsv"
    export RECIPE_QUOTA_METRICS_LOG="$metrics_log"
fi
if [ -n "$metrics_log" ]; then
    metrics_parent=$(dirname "$metrics_log")
    [ -d "$metrics_parent" ] || mkdir -p "$metrics_parent"
fi

[ -x "$evaluator_bin" ] || {
    printf '%s\n' "quota evaluator binary is missing: $evaluator_bin" >&2
    exit 1
}
RECIPE_BINARY=${RECIPE_BINARY:-/home/nate/Desktop/recipe-dev/target/release/recipe}
export RECIPE_BINARY
[ -x "$RECIPE_BINARY" ] || {
    printf '%s\n' "Recipe worker binary is missing: $RECIPE_BINARY" >&2
    exit 1
}
exec "$evaluator_bin" --db "$cache_db" --devices "$evaluator_devices"
