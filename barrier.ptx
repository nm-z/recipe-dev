	ld.param.u64 %rd2, [weights];
	ld.param.u64 %rd1, [packed_x];
	mul.wide.u32 offset, %cta, 8192;
	add.u64 %rd1, %rd1, offset;
	ld.param.u64 %rd3, [scales];
	mul.wide.u32 offset, %cta, 1024;
	add.u64 %rd3, %rd3, offset;
	ld.param.u64 %rd5, [output];
	mov.u32 %r1, tid;
	and.b32  	%r4, %r1, 31;
	shr.u32 	%r5, %r1, 5;
	and.b32  	%r6, %r1, 2;
