// Transport-only all-SM relay using the same runtime completion functions.
.visible .entry p2p_grid_relay(
	.param .u64 local_packet, .param .u64 remote_packet,
	.param .u64 reports, .param .u64 completion,
	.param .u32 die_index, .param .u32 sequence_base,
	.param .u32 hops, .param .u32 seed,
	.param .u32 delay_ns, .param .u32 skip_slot
)
{
	.reg .pred p;
	.reg .b32 tid, cta, grid, linear, stride, die, base, count, seed_value, delay, skip, stage, seq, index, value, v1, v2, v3, want, bad, timeout, ok, tmp, sm;
	.reg .b64 local, remote, report, slots, address, offset, started, ended, limit, until;
	.shared .align 4 .u32 grid_received;
	ld.param.u64 local, [local_packet];
	ld.param.u64 remote, [remote_packet];
	ld.param.u64 report, [reports];
	ld.param.u64 slots, [completion];
	ld.param.u32 die, [die_index];
	ld.param.u32 base, [sequence_base];
	ld.param.u32 count, [hops];
	ld.param.u32 seed_value, [seed];
	ld.param.u32 delay, [delay_ns];
	ld.param.u32 skip, [skip_slot];
	mov.u32 tid, %tid.x;
	mov.u32 cta, %ctaid.x;
	mov.u32 grid, %nctaid.x;
	// CTA 0 transfers the packet; every CTA participates in local completion.
	mad.lo.u32 linear, cta, 4096, tid;
	shl.b32 linear, linear, 2;
	mov.u32 stride, 1024;
	mov.u64 started, %globaltimer;
	add.u64 limit, started, 1000000000;
	mad.lo.u32 tmp, cta, 256, tid;
	mul.wide.u32 offset, tmp, 40;
	add.u64 report, report, offset;
	mov.u32 stage, 1;
	mov.u32 bad, 0;
	mov.u32 timeout, 0;
grid_stage:
	add.u32 seq, base, stage;
	sub.u32 tmp, stage, 1;
	and.b32 tmp, tmp, 1;
	setp.ne.u32 p, tmp, die;
	@p bra grid_receive;
	mov.u32 index, linear;
grid_copy:
	setp.ge.u32 p, index, 4096;
	@p bra grid_arrive;
	add.u32 value, seed_value, index;
	add.u32 value, value, stage;
	sub.u32 value, value, 1;
	mul.wide.u32 offset, index, 4;
	add.u64 address, remote, offset;
	add.u32 v1, value, 1;
	add.u32 v2, value, 2;
	add.u32 v3, value, 3;
	st.volatile.global.v4.u32 [address], {value, v1, v2, v3};
	add.u32 index, index, stride;
	bra grid_copy;
grid_arrive:
	setp.ne.u32 p, cta, 7;
	@p bra grid_skip;
	mov.u64 until, %globaltimer;
	cvt.u64.u32 offset, delay;
	add.u64 until, until, offset;
grid_delay:
	mov.u64 ended, %globaltimer;
	setp.lt.u64 p, ended, until;
	@p bra grid_delay;
grid_skip:
	add.u32 tmp, cta, 1;
	setp.ne.u32 p, tmp, skip;
	@p bra grid_publish;
	setp.eq.u32 p, stage, 1;
	@p bra grid_next;
grid_publish:
	add.u64 address, remote, 16384;
	{
		.param .b64 a, b, d;
		.param .b32 s, r;
		st.param.b64 [a], slots;
		st.param.b64 [b], address;
		st.param.b32 [s], seq;
		st.param.b64 [d], limit;
		call.uni (r), p2p_publish, (a, b, s, d);
		ld.param.b32 ok, [r];
	}
	setp.eq.u32 p, ok, 0;
	@p bra grid_timeout;
	bra grid_next;
grid_receive:
	setp.ne.u32 p, tid, 0;
	@p bra grid_receive_join;
	add.u64 address, local, 16384;
	{
		.param .b64 a, d;
		.param .b32 s, r;
		st.param.b64 [a], address;
		st.param.b32 [s], seq;
		st.param.b64 [d], limit;
		call.uni (r), p2p_wait, (a, s, d);
		ld.param.b32 ok, [r];
	}
	st.shared.u32 [grid_received], ok;
grid_receive_join:
	bar.sync 0;
	ld.shared.u32 ok, [grid_received];
	setp.eq.u32 p, ok, 0;
	@p bra grid_timeout;
	mov.u32 index, linear;
grid_check:
	setp.ge.u32 p, index, 4096;
	@p bra grid_next;
	mul.wide.u32 offset, index, 4;
	add.u64 address, local, offset;
	ld.volatile.global.v4.u32 {value, v1, v2, v3}, [address];
	add.u32 want, seed_value, index;
	add.u32 want, want, stage;
	sub.u32 want, want, 1;
	setp.ne.u32 p, want, value;
	@p add.u32 bad, bad, 1;
	add.u32 want, want, 1;
	setp.ne.u32 p, want, v1;
	@p add.u32 bad, bad, 1;
	add.u32 want, want, 1;
	setp.ne.u32 p, want, v2;
	@p add.u32 bad, bad, 1;
	add.u32 want, want, 1;
	setp.ne.u32 p, want, v3;
	@p add.u32 bad, bad, 1;
	add.u32 index, index, stride;
	bra grid_check;
grid_next:
	// The next publication barrier includes every consumer's preceding checks.
	add.u32 stage, stage, 1;
	setp.le.u32 p, stage, count;
	@p bra grid_stage;
	bra grid_finish;
grid_timeout:
	mov.u32 timeout, stage;
grid_finish:
	mov.u64 ended, %globaltimer;
	mov.u32 sm, %smid;
	st.global.u64 [report], started;
	st.global.u64 [report+8], ended;
	st.global.u32 [report+16], bad;
	st.global.u32 [report+20], timeout;
	st.global.u32 [report+24], sm;
	st.global.u32 [report+28], cta;
	ret;
}
