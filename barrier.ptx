	ld.param.u32 base, [sequence_base];
	ld.param.u32 count, [hops];
	ld.param.u32 row_count, [rows];
	ld.param.u64 expect_base, [expected];
	ld.param.u32 delay, [delay_ns];
	ld.param.u32 skip, [skip_slot];
	mov.u32 tid, %tid.x;
	mov.u32 %cta, %ctaid.x;
	mov.u32 %grid, %nctaid.x;
	mad.lo.u32 linear, %cta, 256, tid;
	mul.lo.u32 stride, %grid, 256;
	shr.u32 %tiles, row_count, 3;
	mov.u64 started, %globaltimer;
	add.u64 limit, started, 1000000000;
	mul.wide.u32 offset, linear, 40;
	add.u64 report, report, offset;
	mov.u32 bad, 0;
	mov.f32 abs_max, 0f00000000;
	mov.u32 timeout, 0;
	mov.u32 stage, 1;
multi_stage:
	add.u32 sequence, base, stage;
	sub.u32 word, stage, 1;
	and.b32 word, word, 1;
	setp.ne.u32 condition, die, word;
	@condition bra multi_receive;
